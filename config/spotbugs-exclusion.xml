<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
        AwaitingAuthCode holds the HttpServer that waits for the redirect. It is an internal handle of the flow:
        the state is kept in a private field of OAuth2AuthCodeFlow and never handed out, so the mutable server
        is not exposed to callers.
    -->
    <Match>
        <Class name="net.nikomitk.ssoauth2.pubclient.authcodeflow.states.AwaitingAuthCode"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
        Lombok @NonNull on constructor parameters of non-final flow classes throws NullPointerException
        on invalid input. Finalizer attacks (OBJ11-J) are not a concern on Java 21 (finalization is
        deprecated for removal per JEP 421).
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

</FindBugsFilter>
